From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aveldistarna <Aveldistarna@users.noreply.github.com>
Date: Tue, 24 Nov 2026 23:25:27 +0900
Subject: [PATCH] ARM: diagnostic tracer for broadcast cache/TLB/BP maintenance (/proc/bcast_trace)

Diagnostic only; off by default and not needed in production.

Records every cache, TLB and branch-predictor maintenance operation that
is broadcast to the other CPUs (and outer cache maintenance), with a
CLOCK_MONOTONIC timestamp, the CPU and the call site, in a ring of 16384
entries. "echo 1 > /proc/bcast_trace" clears the ring and starts
recording, "echo 0" stops, reading the file dumps it. Used to find which
kernel paths stall an isolated CPU.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/include/asm/bcast_trace.h |  27 ++++++++
 arch/arm/include/asm/cacheflush.h  |   3 +
 arch/arm/include/asm/outercache.h  |  15 +++-
 arch/arm/kernel/Makefile           |   2 +-
 arch/arm/kernel/bcast_trace.c      | 107 +++++++++++++++++++++++++++++
 arch/arm/kernel/smp_tlb.c          |  23 +++++--
 arch/arm/kernel/traps.c            |   2 +
 7 files changed, 170 insertions(+), 9 deletions(-)
 create mode 100644 arch/arm/include/asm/bcast_trace.h
 create mode 100644 arch/arm/kernel/bcast_trace.c

diff --git a/arch/arm/include/asm/bcast_trace.h b/arch/arm/include/asm/bcast_trace.h
new file mode 100644
index 000000000000..f86ea04ab23a
--- /dev/null
+++ b/arch/arm/include/asm/bcast_trace.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Diagnostic tracer for the CPU1 jitter study: records every cache/TLB/BP
+ * maintenance operation that is broadcast to the other CPUs (and outer cache
+ * maintenance), with a CLOCK_MONOTONIC timestamp and the call site.
+ * Enabled and read through /proc/bcast_trace.
+ */
+#ifndef __ASM_ARM_BCAST_TRACE_H
+#define __ASM_ARM_BCAST_TRACE_H
+
+enum {
+	BT_ICACHE_ALL, BT_TLB_ALL, BT_TLB_MM, BT_TLB_PAGE, BT_TLB_RANGE,
+	BT_TLB_KPAGE, BT_TLB_KRANGE, BT_BP_ALL, BT_CACHEFLUSH,
+	BT_OUTER_INV, BT_OUTER_CLEAN, BT_OUTER_FLUSH, BT_OUTER_FLUSH_ALL,
+	BT_NTYPES
+};
+
+extern int bcast_trace_on;
+void __bcast_trace(unsigned int type, unsigned long ip, unsigned long arg);
+
+static inline void bcast_trace(unsigned int type, unsigned long ip, unsigned long arg)
+{
+	if (unlikely(bcast_trace_on))
+		__bcast_trace(type, ip, arg);
+}
+
+#endif
diff --git a/arch/arm/include/asm/cacheflush.h b/arch/arm/include/asm/cacheflush.h
index efad3ba8c8cd..2228406f263f 100644
--- a/arch/arm/include/asm/cacheflush.h
+++ b/arch/arm/include/asm/cacheflush.h
@@ -207,8 +207,11 @@ extern void copy_to_user_page(struct vm_area_struct *, struct page *,
 #define __flush_icache_preferred	__flush_icache_all_generic
 #endif
 
+#include <asm/bcast_trace.h>
+
 static inline void __flush_icache_all(void)
 {
+	bcast_trace(BT_ICACHE_ALL, _THIS_IP_, 0);
 	__flush_icache_preferred();
 	dsb(ishst);
 }
