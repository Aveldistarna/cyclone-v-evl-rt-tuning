From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aveldistarna <Aveldistarna@users.noreply.github.com>
Date: Tue, 24 Nov 2026 23:07:15 +0900
Subject: [PATCH] ARM: keep user TLB maintenance local when the mm only ever ran on this CPU

A broadcast TLB maintenance operation stalls every other CPU that
receives it, including an isolated CPU running out-of-band code. When the
current CPU is the only one that ever ran the mm (mm_cpumask(mm) is just
this CPU), no other CPU can hold TLB entries for its ASID, so
flush_tlb_mm(), flush_tlb_page() and flush_tlb_range() can use the local
operations.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/kernel/smp_tlb.c | 57 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 51 insertions(+), 6 deletions(-)

diff --git a/arch/arm/kernel/smp_tlb.c b/arch/arm/kernel/smp_tlb.c
index d4908b3736d8..4107bf679195 100644
--- a/arch/arm/kernel/smp_tlb.c
+++ b/arch/arm/kernel/smp_tlb.c
@@ -175,6 +175,33 @@ static void broadcast_tlb_mm_a15_erratum(struct mm_struct *mm)
 	put_cpu();
 }
 
+/*
+ * True when this CPU is the only one that ever ran @mm, so no other CPU can
+ * hold TLB entries for its ASID and maintenance can stay local. A broadcast
+ * TLB operation stalls every other CPU that receives it, including an
+ * isolated CPU running out-of-band code. Called with preemption disabled.
+ * The barrier pairs with the atomic cpumask update in switch_mm(): either we
+ * see the other CPU in the mask, or it walks the already updated page tables.
+ */
+static bool mm_is_cpu_local(struct mm_struct *mm)
+{
+	smp_mb();
+	return cpumask_equal(mm_cpumask(mm), cpumask_of(smp_processor_id()));
+}
+
+static void local_flush_user_tlb_range(struct vm_area_struct *vma,
+				       unsigned long start, unsigned long end)
+{
+	unsigned long addr;
+
+	if ((end - start) >> PAGE_SHIFT > 64) {
+		local_flush_tlb_mm(vma->vm_mm);
+		return;
+	}
+	for (addr = start & PAGE_MASK; addr < end; addr += PAGE_SIZE)
+		local_flush_tlb_page(vma, addr);
+}
+
 void flush_tlb_all(void)
 {
 	if (tlb_ops_need_broadcast())
@@ -188,8 +215,14 @@ void flush_tlb_mm(struct mm_struct *mm)
 {
 	if (tlb_ops_need_broadcast())
 		on_each_cpu_mask(mm_cpumask(mm), ipi_flush_tlb_mm, mm, 1);
-	else
-		__flush_tlb_mm(mm);
+	else {
+		preempt_disable();
+		if (mm_is_cpu_local(mm))
+			local_flush_tlb_mm(mm);
+		else
+			__flush_tlb_mm(mm);
+		preempt_enable();
+	}
 	broadcast_tlb_mm_a15_erratum(mm);
 }
 
@@ -201,8 +234,14 @@ void flush_tlb_page(struct vm_area_struct *vma, unsigned long uaddr)
 		ta.ta_start = uaddr;
 		on_each_cpu_mask(mm_cpumask(vma->vm_mm), ipi_flush_tlb_page,
 					&ta, 1);
-	} else
-		__flush_tlb_page(vma, uaddr);
+	} else {
+		preempt_disable();
+		if (mm_is_cpu_local(vma->vm_mm))
+			local_flush_tlb_page(vma, uaddr);
+		else
+			__flush_tlb_page(vma, uaddr);
+		preempt_enable();
+	}
 	broadcast_tlb_mm_a15_erratum(vma->vm_mm);
 }
 
@@ -227,8 +266,14 @@ void flush_tlb_range(struct vm_area_struct *vma,
 		ta.ta_end = end;
 		on_each_cpu_mask(mm_cpumask(vma->vm_mm), ipi_flush_tlb_range,
 					&ta, 1);
-	} else
-		local_flush_tlb_range(vma, start, end);
+	} else {
+		preempt_disable();
+		if (mm_is_cpu_local(vma->vm_mm))
+			local_flush_user_tlb_range(vma, start, end);
+		else
+			local_flush_tlb_range(vma, start, end);
+		preempt_enable();
+	}
 	broadcast_tlb_mm_a15_erratum(vma->vm_mm);
 }
 
